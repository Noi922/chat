# Kopiere diese Datei nach .env und passe sie an (Docker Compose liest .env automatisch).

# Port, unter dem der Chat erreichbar ist
PORT=3000

# Name, der im Browser angezeigt wird
SERVER_NAME=Chat

# Passwort für Admin-Rechte im Chat (/admin <Passwort>). Leer = keine Admins.
ADMIN_PASSWORD=

# Bild-Uploads erlauben und begrenzen
ENABLE_UPLOADS=true
MAX_UPLOAD_MB=5
MAX_UPLOAD_DIR_MB=500

# Gespeicherte Nachrichten pro Raum, maximale Nachrichtenlänge, maximale Anzahl Räume
HISTORY_SIZE=1000
MAX_MESSAGE_LENGTH=2000
MAX_ROOMS=100

# Gleichzeitige Verbindungen pro IP-Adresse
MAX_CONNECTIONS_PER_IP=20

# Auf true setzen, wenn der Server hinter einem Reverse-Proxy (Nginx, Caddy, Traefik) läuft,
# damit die echte Adresse der Besucher aus X-Forwarded-For gelesen wird.
TRUST_PROXY=false

# Nur ohne Docker relevant: Speicherort der Daten und Netzwerkschnittstelle
# DATA_DIR=./data
# HOST=127.0.0.1
